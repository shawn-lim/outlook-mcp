# Microsoft Azure App Registration Credentials (shared by every account)
# Azure Portal > App registrations > your app
OUTLOOK_CLIENT_ID=your-client-id-here
# Client secret VALUE (not the secret ID) from Certificates & secrets
OUTLOOK_CLIENT_SECRET=your-client-secret-here

# Tenant:
#   consumers  -> personal Microsoft accounts only (outlook.com / hotmail / live)
#   common     -> personal + work/school
#   <GUID>     -> a single work/school tenant
MS_TENANT_ID=consumers

# Which mailbox this instance uses. Leave unset here and set it per server in the
# Claude config instead (OUTLOOK_ACCOUNT=personal, OUTLOOK_ACCOUNT=second, ...).
# Tokens live in ~/.outlook-mcp/<account>.json
# OUTLOOK_ACCOUNT=personal
# OUTLOOK_TOKEN_PATH=~/custom/path.json   # overrides OUTLOOK_ACCOUNT

# Verbose per-request Graph logging (stderr)
# OUTLOOK_DEBUG=true

USE_TEST_MODE=false
